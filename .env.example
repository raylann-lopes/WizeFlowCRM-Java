# WizeFlow CRM - Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to the repository!

# =============================================
# DEV (Supabase) - used during development
# =============================================
# Supabase > Settings > Database > Connection string (JDBC)
DB_URL=jdbc:postgresql://db.XXXXXXXXXXXX.supabase.co:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=your-supabase-password-here

# =============================================
# PROD (Self-hosted) - used in production
# =============================================
# Set SPRING_PROFILES_ACTIVE=prod on your server
# DB_URL=jdbc:postgresql://your-server-ip:5432/wizeflow_crm
# DB_USERNAME=wizeflow_user
# DB_PASSWORD=your-production-password-here

# =============================================
# SECURITY - JWT Configuration
# =============================================
# IMPORTANT: Generate a strong secret key (minimum 256 bits / 32 characters)
# You can generate one with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long-change-this-in-production
# Token expiration in milliseconds (default: 24 hours)
JWT_EXPIRATION=86400000
# Refresh token expiration in milliseconds (default: 7 days)
JWT_REFRESH_EXPIRATION=604800000
